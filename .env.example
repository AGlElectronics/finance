# ------------------------------------------------------------------------------
# Finance module — local development environment.
# ------------------------------------------------------------------------------

APP_ENV=development
APP_BASE_URL=http://localhost:8130
HTTP_ADDR=:8130

DATABASE_URL=postgres://finance:finance@localhost:5438/finance?sslmode=disable

# Auth: use oidc against the suite Keycloak, or dev for header-only local work.
AUTH_MODE=oidc
OIDC_ISSUER_URL=http://localhost:8085/realms/conservices
OIDC_CLIENT_ID=finance-spa
OIDC_AUDIENCE=finance-spa
DEV_DEFAULT_USER=dev-finance-admin
FINANCE_ACCESS_GROUPS=finance-admin

CORS_ALLOWED_ORIGINS=http://localhost:3004

VITE_API_BASE_URL=http://localhost:8130
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=http://localhost:8085/realms/conservices
VITE_OIDC_CLIENT_ID=finance-spa
VITE_OIDC_SCOPE=openid profile email
VITE_DEV_USER=dev-finance-admin
